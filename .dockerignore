# =============================================================================
# Keep Essential Files (whitelist important files that might be excluded)
# =============================================================================

# Always include these files
!pyproject.toml
!uv.lock
!requirements.txt
!src/
!configs/
!scripts/setup.sh

# Include specific config files needed for runtime
!nginx/nginx.conf
!nginx/conf.d/
!monitoring/prometheus/prometheus.yml
!monitoring/grafana/provisioning/
# Knowledge Ingestor - Docker Build Context Optimization
# This file excludes unnecessary files from the Docker build context to improve build speed and reduce image size

# =============================================================================
# Version Control
# =============================================================================
.git/
.gitignore
.gitattributes
.github/

# =============================================================================
# Python Runtime & Build Artifacts  
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================================================================
# Virtual Environments & Package Managers
# =============================================================================
.venv/
venv/
ENV/
env/
.env.local
.env.*.local
pip-log.txt
pip-delete-this-directory.txt
.Python
.pyenv
.python-version

# UV package manager (keep uv.lock, exclude generated files)
.uv/
uv-cache/


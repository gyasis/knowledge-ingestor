# Knowledge Ingestor Environment Configuration
# Copy this file to .env and fill in your values

# Required: OpenAI API Key for embeddings and text generation
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
DATABASE_BACKEND=deeplake
DATABASE_CONNECTION=./data/deeplake_dataset
DATABASE_READ_ONLY=false
DATABASE_TIMEOUT=30
DATABASE_POOL_SIZE=10

# OpenAI Configuration
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=60

# Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONCURRENT_REQUESTS=5
RETRY_ATTEMPTS=3
RETRY_DELAY=1.0
ENABLE_ASYNC=true
TEMP_DIR=./temp

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE=./logs/knowledge-ingestor.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_ENABLE_COLORS=true

# Plugin Configuration
ENABLED_INGESTORS=web,pdf,arxiv,youtube
ENABLED_DATABASES=deeplake
PLUGIN_AUTO_DISCOVER=true
PLUGIN_PATHS=

# Web Ingestor Configuration
WEB_TIMEOUT=30
WEB_MAX_CONTENT_LENGTH=1000000
WEB_USER_AGENT="Mozilla/5.0 (compatible; KnowledgeIngestor/0.1.0)"
WEB_ENABLE_JAVASCRIPT=false

# Optional: External Services
ACTIVELOOP_TOKEN=your-activeloop-token
MEDIUM_API_KEY=your-medium-api-key

# Optional: Development Settings
DEVELOPMENT=false
DEBUG=false
# Knowledge Ingestor - Environment Configuration Example
# Copy this file to .env and update with your actual values

# =============================================================================
# Core Application Settings
# =============================================================================

# OpenAI API Configuration (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application Environment
ENVIRONMENT=production  # production, development, staging, test
DEBUG=false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Database Configuration
# =============================================================================

# DeepLake Configuration
DATABASE_BACKEND=deeplake
DATABASE_CONNECTION=/app/data/deeplake_dataset

# PostgreSQL Configuration (for metadata and user management)
POSTGRES_DB=knowledge_ingestor
POSTGRES_USER=ingestor
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration (for caching and job queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Performance & Scaling Configuration  
# =============================================================================

# API Performance
MAX_CONCURRENT_REQUESTS=10
CHUNK_SIZE=1000
WORKER_TIMEOUT=300
REQUEST_TIMEOUT=60

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_PREFETCH=1
WORKER_MAX_MEMORY=1G
WORKER_REPLICAS=2

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=7200  # seconds (2 hours)

# API Key Management
API_KEY_SALT=your-api-key-salt-change-this
API_KEY_LENGTH=32

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =============================================================================
# External Service Configuration
# =============================================================================

# Medium API (Optional)
MEDIUM_API_KEY=your-medium-api-key

# Additional API Keys (as needed)
# ANTHROPIC_API_KEY=your-anthropic-key
# HUGGINGFACE_API_KEY=your-huggingface-key

# =============================================================================
# Monitoring & Observability
# =============================================================================

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana Configuration
GRAFANA_PASSWORD=admin123
GRAFANA_PORT=3001

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# =============================================================================
# File Storage & Processing
# =============================================================================

# File Upload Limits
MAX_FILE_SIZE=100M
ALLOWED_FILE_TYPES=pdf,txt,md,html,docx,pptx

# Temporary File Management
TEMP_FILE_RETENTION=3600  # seconds (1 hour)
CACHE_TTL=86400  # seconds (24 hours)

# =============================================================================
# Network & Port Configuration
# =============================================================================

# Service Ports
API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
PROMETHEUS_WEB_PORT=9091

# Development Ports
DEV_API_PORT=8000
DEV_REDIS_PORT=6380
DEV_POSTGRES_PORT=5433
DEV_DEBUG_PORT=5678

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Development Tools
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081
JUPYTER_PORT=8888
JUPYTER_TOKEN=dev-token

# =============================================================================
# Backup & Maintenance
# =============================================================================

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION=30  # days

# Maintenance Windows
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance

# =============================================================================
# Advanced Configuration
# =============================================================================

# Memory Management
PYTHON_MEMORY_LIMIT=2G
WORKER_MEMORY_LIMIT=1G

# Concurrency Settings
ASYNCIO_WORKERS=4
THREAD_POOL_SIZE=10

# Timeout Configuration
HTTP_TIMEOUT=30
DATABASE_TIMEOUT=10
REDIS_TIMEOUT=5

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# =============================================================================
# Development-Specific Settings
# =============================================================================

# Hot Reloading
WATCHFILES_FORCE_POLLING=false
RELOAD_DIRS=src

# Testing
TEST_DATABASE_CONNECTION=/app/data/test_deeplake_dataset
PYTEST_MARKERS=not slow

# Debug Settings
PYTHON_TRACEBACK_LIMIT=10
DEBUG_SQL=false

# =============================================================================
# Production-Specific Settings
# =============================================================================

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Load Balancing
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=4096

# Logging
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_MAX_SIZE=100M
LOG_BACKUP_COUNT=30

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=63072000

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/Disable Features
FEATURE_ASYNC_PROCESSING=true
FEATURE_BATCH_UPLOADS=true
FEATURE_WEBHOOK_NOTIFICATIONS=false
FEATURE_METRICS_COLLECTION=true
FEATURE_RATE_LIMITING=true

# =============================================================================
# Cloud Provider Settings (Optional)
# =============================================================================

# AWS Configuration
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-west-2
# AWS_S3_BUCKET=your-s3-bucket

# Google Cloud Configuration  
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Azure Configuration
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_STORAGE_KEY=your-storage-key

# =============================================================================
# Notification Settings
# =============================================================================

# Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# EMAIL_FROM=noreply@yourdomain.com

# Slack Integration
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord Integration
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK
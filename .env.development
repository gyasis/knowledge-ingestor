# Knowledge Ingestor - Development Environment Configuration
# Pre-configured for local development with sensible defaults

# =============================================================================
# Core Application Settings
# =============================================================================

# OpenAI API Configuration (Required - add your key)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# Database Configuration
# =============================================================================

# DeepLake Configuration
DATABASE_BACKEND=deeplake
DATABASE_CONNECTION=/app/data/deeplake_dataset_dev

# PostgreSQL Configuration (Development)
POSTGRES_DB=knowledge_ingestor_dev
POSTGRES_USER=ingestor
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=postgres-dev
POSTGRES_PORT=5432

# Redis Configuration (Development)
REDIS_HOST=redis-dev
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis-dev:6379/0

# =============================================================================
# Performance & Scaling Configuration (Relaxed for Dev)
# =============================================================================

# API Performance
MAX_CONCURRENT_REQUESTS=5
CHUNK_SIZE=500
WORKER_TIMEOUT=60
REQUEST_TIMEOUT=30

# Worker Configuration
WORKER_CONCURRENCY=2
WORKER_PREFETCH=1
WORKER_MAX_MEMORY=512M
WORKER_REPLICAS=1

# =============================================================================
# Security Configuration (Development - Not Secure!)
# =============================================================================

# JWT Authentication
JWT_SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400  # 24 hours for development

# API Key Management
API_KEY_SALT=dev-salt
API_KEY_LENGTH=16

# CORS Settings (Permissive for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# External Service Configuration
# =============================================================================

# Medium API (Optional)
# MEDIUM_API_KEY=your-medium-api-key

# =============================================================================
# Monitoring & Observability (Disabled for Dev)
# =============================================================================

# Prometheus Metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Grafana Configuration
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001

# Health Check Configuration (Faster for dev)
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5

# =============================================================================
# File Storage & Processing
# =============================================================================

# File Upload Limits (Smaller for dev)
MAX_FILE_SIZE=50M
ALLOWED_FILE_TYPES=pdf,txt,md,html,docx

# Temporary File Management
TEMP_FILE_RETENTION=1800  # 30 minutes
CACHE_TTL=3600  # 1 hour

# =============================================================================
# Network & Port Configuration
# =============================================================================

# Service Ports
DEV_API_PORT=8000
DEV_REDIS_PORT=6380
DEV_POSTGRES_PORT=5433
DEV_DEBUG_PORT=5678

# Development Tools
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081
JUPYTER_PORT=8888
JUPYTER_TOKEN=dev-token

# =============================================================================
# Development-Specific Settings
# =============================================================================

# Hot Reloading
WATCHFILES_FORCE_POLLING=true
RELOAD_DIRS=src

# Testing
TEST_DATABASE_CONNECTION=/app/data/test_deeplake_dataset
PYTEST_MARKERS=not slow

# Debug Settings
PYTHON_TRACEBACK_LIMIT=50
DEBUG_SQL=true

# =============================================================================
# Feature Flags (More permissive for dev)
# =============================================================================

# Enable/Disable Features
FEATURE_ASYNC_PROCESSING=true
FEATURE_BATCH_UPLOADS=true
FEATURE_WEBHOOK_NOTIFICATIONS=false
FEATURE_METRICS_COLLECTION=false
FEATURE_RATE_LIMITING=false

# =============================================================================
# Logging Configuration (Verbose for dev)
# =============================================================================

LOG_FORMAT=text
LOG_ROTATION=never
LOG_MAX_SIZE=50M
LOG_BACKUP_COUNT=3